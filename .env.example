SLACK_USER_TOKEN=xoxp-your-token-here
SLACK_APP_TOKEN=xapp-your-token-here
# Optional: channel ID (C0123456789). Several can be comma-separated. If empty, it replies everywhere.
SLACK_CHANNEL_ID=
# Required: GIF URLs as a JSON array (a comma-separated list also works)
GIFS=["https://media.giphy.com/media/yznMzHpdxOpQSrNmE1/giphy.gif","https://media.giphy.com/media/TlMf43T37mdc501iYT/giphy.gif","https://media.giphy.com/media/ZJieMJ372LLjXsInfV/giphy.gif"]
# Optional: random wait in seconds before replying (defaults 5 and 45)
REPLY_DELAY_MIN=5
REPLY_DELAY_MAX=45
# Optional: chance of replying (0-1, default 1) and seconds between replies per channel (default 7200 = 2 h)
REPLY_PROBABILITY=1
REPLY_COOLDOWN=7200
